# ---- 机密：绝对不要提交 ----
# 注意：admin.json 已纳入版本控制（引导管理员的明文密码就在这里），
#       克隆后请立即修改，或用 env 变量 AGENTGATE_ADMIN_USER/_PASS 覆盖
.env

# ---- 运行期数据（数据库、密钥、工具组包与上传文件）----
data/
*.db
*.db-wal
*.db-shm
*.db.bak-*

# ---- 重置前的数据备份（含真实上游密钥，切勿提交）----
backup-before-reset-*/

# ---- 本地助手脚本 ----
push-to-github.ps1

# ---- Python ----
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
build/
dist/
*.egg-info/

# ---- 编辑器 ----
.idea/
.vscode/

# ---- pip 临时目录（安装失败会留下被锁的临时目录，可手动删）----
.piptmp/
.pipcache/
.tmp/
.tmp2/
vendor/
